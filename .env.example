# Copy to .env and fill in every required value. Never commit .env.
# Generate a new hex password: openssl rand -hex 32
POSTGRES_PASSWORD=
# Existing XBT Knots node, reachable from Docker. No SHA-256 BTC backend.
XBT_RPC_URL=http://host.docker.internal:9332/
XBT_RPC_USER=
XBT_RPC_PASSWORD=
XBT_P2P_ENDPOINT=host.docker.internal:9333
# Absolute path to the existing XBT CLN Unix RPC socket (not its data directory).
CLN_SOCKET=
CLN_NODE_ID=
# Supplemental group with read/write access to the upstream RPC socket.
CLN_RPC_GID=1000
# Optional IPv4/IPv6 P2P endpoint when CLN has no announced addresses.
CLN_ADVERTISE_HOST=
CLN_ADVERTISE_PORT=9735
